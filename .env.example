# 复制为 .env 后填入真实值：cp .env.example .env
# 1. APPLE_ID：你的 Apple ID 邮箱
# 2. APPLE_APP_SPECIFIC_PASSWORD：在 appleid.apple.com 生成的「app 专用密码」（不是 Apple ID 密码）
# 3. APPLE_TEAM_ID：10 位团队 ID，在 developer.apple.com → Membership 查看
APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=ABCDE12345

# 可选：设了它，构建后会自动把安装包上传到 GitHub Release（自动更新依赖它）
# 在 github.com → Settings → Developer settings → Personal access tokens 生成，勾选 repo 权限
GH_TOKEN=
